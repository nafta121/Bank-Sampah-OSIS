rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Health / Connection test document
    match /test/{testId} {
      allow read, write: if true;
    }

    // Classes collection: real-time live synced class profiles and points
    match /classes/{classId} {
      allow get: if isValidId(classId);
      allow list: if true;
      allow create, update: if isValidId(classId) 
        && request.resource.data.classId is string
        && request.resource.data.name is string
        && request.resource.data.points is number
        && request.resource.data.balance is number
        && request.resource.data.totalWeightKg is number;
      allow delete: if false;
    }

    // Transactions collection: real-time deposit stream and audit records
    match /transactions/{transactionId} {
      allow get: if isValidId(transactionId);
      allow list: if true;
      allow create: if isValidId(transactionId)
        && request.resource.data.transactionId is string
        && request.resource.data.classId is string
        && request.resource.data.category is string
        && request.resource.data.weightKg is number
        && request.resource.data.pointsEarned is number
        && request.resource.data.cashEarned is number;
      allow update: if isValidId(transactionId);
      allow delete: if false;
    }

    // Redemptions collection: points & cash reward redemption records
    match /redemptions/{redemptionId} {
      allow get: if isValidId(redemptionId);
      allow list: if true;
      allow create: if isValidId(redemptionId)
        && request.resource.data.redemptionId is string
        && request.resource.data.classId is string
        && request.resource.data.rewardTitle is string
        && request.resource.data.status is string;
      allow update: if isValidId(redemptionId);
      allow delete: if false;
    }

    // Notifications collection: alerts and balance-ready notifications
    match /notifications/{notificationId} {
      allow get: if isValidId(notificationId);
      allow list: if true;
      allow create: if isValidId(notificationId)
        && request.resource.data.notificationId is string
        && request.resource.data.classId is string
        && request.resource.data.title is string
        && request.resource.data.message is string;
      allow update: if isValidId(notificationId);
      allow delete: if isValidId(notificationId);
    }
  }
}
