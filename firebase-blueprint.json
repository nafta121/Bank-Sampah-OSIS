{
  "entities": {
    "ClassProfile": {
      "title": "ClassProfile",
      "description": "Profile data and waste bank points for a school class",
      "type": "object",
      "properties": {
        "classId": { "type": "string", "description": "Unique identifier of the class" },
        "name": { "type": "string", "description": "Display name of class e.g. X MIPA 1" },
        "points": { "type": "number", "description": "Accumulated redeemable points" },
        "balance": { "type": "number", "description": "Accumulated cash balance in IDR" },
        "totalWeightKg": { "type": "number", "description": "Total weight of waste collected in kg" },
        "username": { "type": "string", "description": "Standard login username for the class (e.g. x-mipa-1)" },
        "pin": { "type": "string", "description": "Access PIN code for class verification" },
        "representative": { "type": "string", "description": "Class waste coordinator or leader name" },
        "updatedAt": { "type": "string", "description": "ISO timestamp of last update" }
      },
      "required": ["classId", "name", "points", "balance", "totalWeightKg"]
    },
    "WasteTransaction": {
      "title": "WasteTransaction",
      "description": "Waste deposition record by class",
      "type": "object",
      "properties": {
        "transactionId": { "type": "string", "description": "Unique transaction ID" },
        "classId": { "type": "string", "description": "Class identifier" },
        "category": { "type": "string", "description": "Category of waste e.g. Plastik, Kertas, Logam" },
        "weightKg": { "type": "number", "description": "Weight of deposited waste in kilograms" },
        "pointsEarned": { "type": "number", "description": "Points credited" },
        "cashEarned": { "type": "number", "description": "Cash value credited in IDR" },
        "recordedBy": { "type": "string", "description": "OSIS operator or student ID" },
        "timestamp": { "type": "string", "description": "Date and time of transaction" },
        "status": { "type": "string", "description": "Status e.g. synced or pending" },
        "notes": { "type": "string", "description": "Optional notes on waste condition" }
      },
      "required": ["transactionId", "classId", "category", "weightKg", "pointsEarned", "cashEarned", "timestamp"]
    },
    "RewardRedemption": {
      "title": "RewardRedemption",
      "description": "Redemption of points/balance for classroom supplies or cash disbursement",
      "type": "object",
      "properties": {
        "redemptionId": { "type": "string", "description": "Unique redemption ID" },
        "uniqueCode": { "type": "string", "description": "Unique pickup verification code for Kopsis claim (e.g. KOPS-XM1-892)" },
        "studentName": { "type": "string", "description": "Name of student or coordinator picking up at kopsis" },
        "classId": { "type": "string", "description": "Class requesting redemption" },
        "rewardTitle": { "type": "string", "description": "Name of reward or cash disbursement" },
        "pointsSpent": { "type": "number", "description": "Points deducted" },
        "cashSpent": { "type": "number", "description": "Cash deducted" },
        "status": { "type": "string", "description": "Status e.g. requested, approved, completed" },
        "requestedAt": { "type": "string", "description": "Timestamp of request" }
      },
      "required": ["redemptionId", "classId", "rewardTitle", "status", "requestedAt"]
    },
    "NotificationItem": {
      "title": "NotificationItem",
      "description": "Class reminder notification when balance/points are sufficient for rewards",
      "type": "object",
      "properties": {
        "notificationId": { "type": "string", "description": "Unique notification ID" },
        "classId": { "type": "string", "description": "Target class identifier" },
        "title": { "type": "string", "description": "Notification title" },
        "message": { "type": "string", "description": "Notification message" },
        "type": { "type": "string", "description": "Notification category e.g. reward_ready, milestone" },
        "isRead": { "type": "boolean", "description": "Read flag" },
        "createdAt": { "type": "string", "description": "Timestamp created" }
      },
      "required": ["notificationId", "classId", "title", "message", "type", "createdAt"]
    }
  },
  "firestore": {
    "/classes/{classId}": {
      "schema": { "$ref": "#/entities/ClassProfile" },
      "description": "Store class profiles, total accumulated points, balance, and PIN"
    },
    "/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/WasteTransaction" },
      "description": "Log of waste collection transactions"
    },
    "/redemptions/{redemptionId}": {
      "schema": { "$ref": "#/entities/RewardRedemption" },
      "description": "Reward redemption and cashout history"
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/NotificationItem" },
      "description": "Notifications alerting classes of redeemable balances and milestones"
    }
  }
}
